# Virtual environment
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Raw market data — re-fetched by Actions cache each run
data/raw/
data/processed/
data/outputs/
data/cache/

# Logs — visible in Actions UI, don't clutter repo
logs/

# Reports — deployed to GitHub Pages, not committed to main
reports/

# Keep portfolio state — this is the engine's persistent memory
!data/paper_portfolio/
!data/paper_portfolio/portfolio_state.json

# Keep backtest result history (small JSON summaries, not the HTML/PNG
# report artifacts — those are gitignored under data/outputs/ and go to
# gh-pages only) — a version-controlled record of how each scheduled
# backtest assessed the strategy over time.
!data/backtest_history/
!data/backtest_history/*.json

# macOS
.DS_Store
